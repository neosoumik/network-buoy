# Never run install scripts from packages (prevents supply chain attacks)
ignore-scripts=true

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Pin all future installs to exact versions — no ^ or ~ drift
save-exact=true

# Fail on peer dependency mismatches — catches silent version conflicts
strict-peer-dependencies=true

# Always use the lockfile in CI — fail if it would change
frozen-lockfile=true
